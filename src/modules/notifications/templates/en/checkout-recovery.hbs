<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header {{#if primaryColor}}background: {{primaryColor}};{{else}}background: #1a1a2e;{{/if}} color: white; padding: 24px; border-radius: 8px 8px 0 0; text-align: center; }
    .header h1 { margin: 0; font-size: 24px; }
    .logo { max-width: 120px; max-height: 60px; margin-bottom: 8px; }
    .body { background: #fff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .amount { font-size: 28px; font-weight: bold; text-align: center; margin: 16px 0; }
    .items { width: 100%; border-collapse: collapse; margin: 16px 0; }
    .items td { padding: 8px 4px; border-bottom: 1px solid #e5e7eb; }
    .cta { display: inline-block; background: {{#if primaryColor}}{{primaryColor}}{{else}}#1a1a2e{{/if}}; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; margin: 16px 0; }
    .footer { text-align: center; font-size: 12px; color: #9ca3af; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #6b7280; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      {{#if merchantLogo}}<img src="{{merchantLogo}}" alt="{{merchantName}}" class="logo">{{/if}}
      <h1>Your checkout is waiting</h1>
    </div>
    <div class="body">
      <p>Hello,</p>
      <p>You started a checkout at <strong>{{merchantName}}</strong> but did not finish it. Your items are still available — complete your purchase with the link below.</p>
      <div class="amount">{{formattedTotal}} {{currency}}</div>
      <table class="items">
        {{#each items}}
        <tr><td>{{quantity}} x {{name}}</td></tr>
        {{/each}}
      </table>
      <p><a class="cta" href="{{recoveryUrl}}">Complete checkout</a></p>
      <p>If you have already completed your purchase, you can safely ignore this email.</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} {{merchantName}}. All rights reserved.</p>
      <p><a href="{{unsubscribeUrl}}">Unsubscribe</a></p>
    </div>
  </div>
</body>
</html>
